# Firebase Service Account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server
PORT=4000

# Mock data generator (set to 'false' to disable, defaults to 'true')
USE_MOCK_DATA=true

# Twilio WhatsApp Sandbox (optional — alerts on red-status transitions)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=

